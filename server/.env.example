NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/estimator
DB_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# tesseract = free local OCR (default). mock = fake items for testing the app without a photo reader.
EXTRACTION_MODE=tesseract
# Languages, joined with +. eng+nep reads English and Nepali. Use eng only for faster, slightly cleaner digits.
TESSERACT_LANGS=eng+nep

# Optional: keep uploaded photos in an S3-compatible bucket (leave empty to skip)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Comma-separated origins. The mobile app does not need CORS.
CORS_ORIGINS=

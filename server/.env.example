NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/estimator
DB_SSL=false
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars
JWT_EXPIRES_IN=7d

# tesseract = free local OCR (default). mock = fake items, for testing the app without a real photo.
EXTRACTION_MODE=tesseract
# Languages joined with +. eng+nep reads English and Nepali. Use eng for faster, slightly cleaner digits.
TESSERACT_LANGS=eng+nep
# true = log what Tesseract read and save the photo it received (temp folder). Turn off afterwards.
OCR_DEBUG=false

# Photos are saved on this server's disk, in this folder (relative to where you start the server).
UPLOAD_DIR=./uploads

# Comma-separated origins. The mobile app does not need CORS.
CORS_ORIGINS=

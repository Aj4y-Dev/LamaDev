{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/jwt": "^11",
    "@nestjs/passport": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/throttler": "^6",
    "@nestjs/typeorm": "^11",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/nep": "^1.0.0",
    "bcryptjs": "^3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "decimal.js": "^10",
    "helmet": "^8",
    "passport": "^0.7",
    "passport-jwt": "^4",
    "pg": "^8",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "sharp": "*",
    "tesseract.js": "^7.0.0",
    "typeorm": "^0.3",
    "zod": "^3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@types/express": "^5",
    "@types/jest": "^29",
    "@types/multer": "^2",
    "@types/node": "^22",
    "@types/passport-jwt": "^4",
    "jest": "^29",
    "ts-jest": "^29",
    "ts-node": "^10",
    "typescript": "^5.9"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
